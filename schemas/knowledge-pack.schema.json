{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embedded Trainer Knowledge Pack v1",
  "type": "object",
  "required": ["formatVersion", "id", "version", "title", "minEngineVersion", "license"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,99}$" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "minEngineVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "description": "SPDX identifier or mixed; LicenseRef-Pending is editable but cannot be published." },
    "files": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
  },
  "additionalProperties": false
}
