{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized knowledge package questions",
  "type": "object",
  "required": ["formatVersion", "questions"],
  "properties": {
    "formatVersion": { "const": 1 },
    "questions": {
      "type": "array", "minItems": 1, "maxItems": 5000,
      "items": { "$ref": "lesson.schema.json" }
    }
  },
  "additionalProperties": false
}
