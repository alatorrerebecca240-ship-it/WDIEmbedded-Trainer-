{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embedded Trainer training route v1",
  "description": "路线只引用知识包题目 ID。跨阶段题目 ID 唯一性由插件验证。",
  "type": "object",
  "required": [
    "formatVersion",
    "id",
    "version",
    "title",
    "description",
    "stages"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,119}$",
      "not": {
        "enum": [
          "__proto__",
          "prototype",
          "constructor"
        ]
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "summary",
          "minutes",
          "concepts",
          "example",
          "predict",
          "required",
          "optional",
          "checkpoint",
          "projectStep"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,119}$",
            "not": {
              "enum": [
                "__proto__",
                "prototype",
                "constructor"
              ]
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "concepts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 6000
            }
          },
          "example": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "predict": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "required": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,119}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            }
          },
          "optional": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,119}$",
              "not": {
                "enum": [
                  "__proto__",
                  "prototype",
                  "constructor"
                ]
              }
            }
          },
          "checkpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          },
          "projectStep": {
            "type": "string",
            "minLength": 1,
            "maxLength": 6000
          }
        }
      }
    }
  }
}
